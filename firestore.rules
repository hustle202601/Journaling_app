rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resource) {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // User profile + starting balance.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Trades are readable by their owner. Browsers may only create/update
    // manual (report imported) trades. MT5-synced trades are written by the
    // server with a service account, which bypasses these rules.
    match /trades/{tradeId} {
      allow read: if owns(resource);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.source == 'manual';
      allow update: if owns(resource)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.source == resource.data.source;
      allow delete: if owns(resource);
    }

    // MT5 connection metadata is created and changed by the server only.
    match /mt5Accounts/{accountId} {
      allow read: if owns(resource);
      allow write: if false;
    }

    // Open positions are replaced by the EA sync endpoint.
    match /mt5OpenPositions/{positionId} {
      allow read: if owns(resource);
      allow write: if false;
    }

    // Sync audit log.
    match /mt5SyncRuns/{runId} {
      allow read: if owns(resource);
      allow write: if false;
    }

    // Connection tokens are only looked up by the server. Never expose them.
    match /mt5ConnectionTokens/{tokenHash} {
      allow read, write: if false;
    }
  }
}
