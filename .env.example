# Firebase Web SDK configuration (safe to expose to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only: base64-encoded Firebase service-account JSON (never expose to the browser)
# Generate with:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes(".secrets/firebase-service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
